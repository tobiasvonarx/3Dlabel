# Local application server (frontend is served from dist/).
HOST=127.0.0.1
PORT=5003
# Acquisition/download worker budget; the application uses one server process.
WORKERS=4
DATA_DIR=./data
# Optional explicitly managed bundle roots, separated by the platform path separator.
LABEL3D_SCENE_ROOTS=
# Native GDAL prefix; scripts/setup.sh writes the local .native path automatically.
NATIVE_PREFIX=
# Optional browser key for Google Photorealistic 3D Tiles; restrict it by HTTP referrer.
GOOGLE_CLOUD_API_KEY=
# Frontend development only: Python backend URL used by the Vite proxy.
LABEL3D_BACKEND_URL=http://127.0.0.1:5003
